# ………… 必填字段（⚠️ 部署前必须修改）…………
JWT_SECRET=<CHANGE_ME-use-openssl-rand-hex-32>
JWT_REFRESH_SECRET=<CHANGE_ME-use-openssl-rand-hex-32>
JWT_SECRET_SSO=$(openssl rand -hex 32)
SEED_PASSWORD=<CHANGE_ME-at-least-16-chars>
POSTGRES_PASSWORD=<CHANGE_ME-at-least-16-chars>

# ………… 可按需修改 …………
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/agent_dev_center?schema=public
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d
FRONTEND_ORIGIN=http://localhost:5173
FEISHU_WEBHOOK_URL=
AGENT_CALLBACK_URL=

# Isolated svc-workflow client smoke. The short-lived token and fixture IDs must
# be injected only when running `npm --workspace @agent-dev-center/backend run smoke:svc-workflow-client`.
SVC_WORKFLOW_BASE_URL=http://127.0.0.1:8989
SVC_WORKFLOW_REQUEST_TIMEOUT_MS=35000
SVC_WORKFLOW_MAX_ATTEMPTS=3
# SVC_WORKFLOW_SMOKE_CONFIRM=isolated-test-only
# SVC_WORKFLOW_SMOKE_ACCESS_TOKEN=
# SVC_WORKFLOW_SMOKE_DOMAIN_ID=
# SVC_WORKFLOW_SMOKE_DEFINITION_VERSION_ID=
# SVC_WORKFLOW_SMOKE_TRANSITION_DEFINITION_ID=

# Service registry public URL (override for production deployments)
ADC_PUBLIC_URL=http://localhost:4000
SERVER_HOST=<CHANGE_ME-your-server-ip>

# Docker Postgres
POSTGRES_DB=agent_dev_center
POSTGRES_USER=postgres
